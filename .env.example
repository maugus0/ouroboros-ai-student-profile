# ======================================
# STUDENT PROFILE AGENT - CONFIGURATION
# ======================================

# -------- Database (MySQL) --------
DB_HOST=localhost
DB_NAME=student_profile_db
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_PORT=3306

DB_POOL_SIZE=10
DB_POOL_NAME=student_profile_pool
DB_CONNECTION_TIMEOUT=20

# Docker MySQL port (host-side)
DOCKER_MYSQL_PORT=3308

# -------- Inter-Service Authentication --------
# All inter-service communication now uses Kubernetes-native internal bearer tokens.
# Legacy X-Service-Token support has been removed.

INTERNAL_TOKEN_VERIFY_ENABLED=true
INTERNAL_TOKEN_SIGNING_ALGORITHM=RS256
INTERNAL_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nACTIVE_INTERNAL_SIGNING_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
INTERNAL_TOKEN_JWKS_URL=http://ouroboros-ai-orchestrator:8000/internal/.well-known/jwks.json
INTERNAL_TOKEN_JWKS_REFRESH_SECONDS=60
INTERNAL_TOKEN_JWKS_TIMEOUT_SECONDS=2
INTERNAL_TOKEN_AUDIENCE=ouroboros.student-profile
INTERNAL_TOKEN_ISSUER=ouroboros-orchestrator-internal

# -------- LLM Configuration --------
# Primary: OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.0

# Fallback: Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=2000

PROFILE_EXTRACTION_PROMPT_VERSION=v2
TARGET_DEGREE_PROMPT_VERSION=v2
GAP_ANALYSIS_PROMPT_VERSION=v2

ENABLE_PROMPT_INJECTION_DETECTION=true
ENABLE_OUTPUT_VALIDATION=true
MAX_INPUT_LENGTH=10000
ENABLE_SECURITY_CHECKS=true

# Retry
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2

# -------- Document Processing --------
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx
TEMP_UPLOAD_DIR=/tmp/uploads
# TESSERACT_PATH=/usr/bin/tesseract
OCR_LANGUAGE=eng

# -------- Application --------
LOG_LEVEL=INFO
USE_MOCK_DATA=false
ALLOW_DB_FAILURE=false